import tkinter as tk
from tkinter import scrolledtext
from PIL import Image, ImageTk
from google import genai
from google.genai import types
import threading
import json
import os

# ================== API ==================
# Initialize the client with the new SDK structure
client = genai.Client(api_key="ENTER_YOUR_API_KEY").env

# Updated to the current GA model (1.5-flash is deprecated)
MODEL_ID = "gemini-2.5-flash" 

# ================== MEMORY FILE ==================
MEMORY_FILE = "memory.json"

# ================== LOAD MEMORY ==================
def load_memory():
    if os.path.exists(MEMORY_FILE):
        try:
            with open(MEMORY_FILE, "r", encoding="utf-8") as f:
                raw_history = json.load(f)
                
                # Convert the raw JSON dictionaries into the SDK's Content objects
                formatted_history = []
                for item in raw_history:
                    # Handle safely extracting text from the saved JSON
                    text_content = item["parts"][0]
                    if isinstance(text_content, dict):
                        text_content = text_content.get("text", "")
                        
                    formatted_history.append(
                        types.Content(
                            role=item["role"],
                            parts=[types.Part.from_text(text=text_content)]
                        )
                    )
                return formatted_history
        except Exception as e:
            print(f"Warning: Memory file was corrupted or unreadable. Starting fresh. Error: {e}")
            return []
    return []

# ================== SAVE MEMORY ==================
def save_memory(history):
    formatted_history = []
    for message in history:
        try:
            formatted_history.append({
                "role": message.role,
                "parts": [{"text": message.parts[0].text}]
            })
        except Exception as e:
            print(f"Skipped saving a message due to formatting: {e}")
            
    with open(MEMORY_FILE, "w", encoding="utf-8") as f:
        json.dump(formatted_history, f, indent=2)

# ================== INIT CHAT ==================
chat_history = load_memory()

# Start chat uses the new client.chats.create method
chat = client.chats.create(
    model=MODEL_ID,
    history=chat_history
)

# ================== AI ==================
def get_ai_response(user_input):
    try:
        response = chat.send_message(user_input)

        # Save updated history (using get_history() in the new SDK)
        save_memory(chat.get_history())

        return response.text.strip()
    except Exception as e:
        print(f"API Error: {e}") 
        return "⚠️ Error: Something went wrong. Check the terminal for details."

# ================== SEND ==================
def send_message(event=None):
    user_input = entry_box.get().strip()
    if not user_input:
        return

    entry_box.delete(0, tk.END)
    display_message(user_input, "user")

    show_typing()

    threading.Thread(target=handle_response, args=(user_input,), daemon=True).start()

# ================== HANDLE ==================
def handle_response(user_input):
    response = get_ai_response(user_input)
    window.after(0, lambda: update_chat(response))

def update_chat(response):
    remove_typing()
    display_message(response, "bot")

# ================== DISPLAY ==================
def display_message(message, sender):
    chat_box.config(state=tk.NORMAL)

    if sender == "user":
        chat_box.insert(tk.END, f"  {message}\n\n", "user")

    elif sender == "bot":
        chat_box.image_create(tk.END, image=bot_avatar)
        chat_box.insert(tk.END, f"  {message}\n\n", "bot")

    chat_box.yview(tk.END)
    chat_box.config(state=tk.DISABLED)

# ================== TYPING ==================
typing_index = None

def show_typing():
    global typing_index
    chat_box.config(state=tk.NORMAL)
    typing_index = chat_box.index(tk.END)
    chat_box.insert(tk.END, "  Typing...\n", "typing")
    chat_box.config(state=tk.DISABLED)

def remove_typing():
    global typing_index
    chat_box.config(state=tk.NORMAL)
    if typing_index:
        chat_box.delete(typing_index, f"{typing_index} lineend+1c")
    chat_box.config(state=tk.DISABLED)

# ================== GUI ==================
window = tk.Tk()
window.title("Arpan's AI Chatbot 🤖")
window.geometry("520x620")
window.configure(bg="#0f172a")

# Avatar - With fallback
try:
    img = Image.open("bot.png")
    img = img.resize((40, 40))
    bot_avatar = ImageTk.PhotoImage(img)
except FileNotFoundError:
    print("Warning: 'bot.png' not found. Using a blank placeholder.")
    img = Image.new('RGB', (40, 40), color='#334155')
    bot_avatar = ImageTk.PhotoImage(img)

# Header
header = tk.Label(window, text="AI Chatbot",
                  bg="#0f172a", fg="white",
                  font=("Arial", 18, "bold"))
header.pack(pady=10)

# Chat box
chat_box = scrolledtext.ScrolledText(
    window,
    wrap=tk.WORD,
    state=tk.DISABLED,
    bg="#1e293b",
    fg="white",
    font=("Arial", 11),
    padx=10,
    pady=10
)
chat_box.pack(padx=10, pady=10, fill=tk.BOTH, expand=True)

# Styles
chat_box.tag_config("user",
                    background="#2563eb",
                    foreground="white",
                    justify="right",
                    lmargin1=120,
                    lmargin2=120,
                    rmargin=10,
                    spacing3=10)

chat_box.tag_config("bot",
                    background="#334155",
                    foreground="white",
                    justify="left",
                    lmargin1=10,
                    lmargin2=60,
                    rmargin=120,
                    spacing3=10)

chat_box.tag_config("typing",
                    foreground="#94a3b8",
                    font=("Arial", 10, "italic"))

# Input
bottom_frame = tk.Frame(window, bg="#0f172a")
bottom_frame.pack(fill=tk.X, padx=10, pady=10)

entry_box = tk.Entry(bottom_frame, font=("Arial", 12))
entry_box.pack(side=tk.LEFT, fill=tk.X, expand=True, padx=(0, 10))
entry_box.bind("<Return>", send_message)

send_button = tk.Button(
    bottom_frame,
    text="Send",
    command=send_message,
    bg="#22c55e",
    fg="white",
    font=("Arial", 10, "bold"),
    padx=15,
    pady=5
)
send_button.pack(side=tk.RIGHT)

window.mainloop()
